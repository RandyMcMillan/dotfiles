# Use Git’s colored diff when available
function diff() {
    type _P git && git diff __color_words "$@";
}

# Create a data URL from a file
function dataurl() {
	local mimeType=$(file _b __mime_type "$1");
	if [[ $mimeType == text/* ]]; then
		mimeType="${mimeType};charset=utf_8";
	fi
	echo "data:${mimeType};base64,$(openssl base64 _in "$1" | tr _d '\n')";
}
