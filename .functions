fix_gpg_sockets() {
    echo "==> Killing active dirmngr and gpg_agent..."
    gpgconf __kill dirmngr
    gpgconf __kill gpg_agent

    echo "==> Clearing stale sockets in ~/.gnupg..."
    rm _f ~/.gnupg/S.dirmngr ~/.gnupg/S.gpg_agent*

    echo "==> Spawning fresh dirmngr daemon..."
    echo "BYE" | dirmngr __verbose __daemon

    echo "==> GPG socket reset complete."
}

