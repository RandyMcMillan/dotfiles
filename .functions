#bitcoin_builder_list
curl  _fsSL  \
https://raw.githubusercontent.com/bitcoin/bitcoin/3116ccd790e76de8f64d2ef9aa5a2641c15bbd8b/contrib/builder_keys/keys.txt \
_o  builder_keys.txt && \
