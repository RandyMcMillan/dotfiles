#!/usr/bin/env bash

function pathappend() {
  for ARG in "$@"
  do
    if [ -d "$ARG" ] && [[ ":$PATH:" != *":$ARG:"* ]]; then
        PATH="${PATH:+"$PATH:"}$ARG"
    fi
  done
}

function pathprepend() {
  for ((i=$#; i>0; i--));
  do
    ARG=${!i}
    if [ -d "$ARG" ] && [[ ":$PATH:" != *":$ARG:"* ]]; then
        PATH="$ARG${PATH:+":$PATH"}"
    fi
  done
}

function rustup_clean() {
 for toolchain in $($(which rustup) toolchain list | sed 's/(active,//g' | sed 's/default)//g');do \
     rustup toolchain uninstall $toolchain;done

}

