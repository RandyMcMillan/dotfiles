curl  _fsSL \
$LAANWJ_LIST \
_o  keys.txt && \
shasum _a 256 keys.txt > keys.shasum.1.txt
#echo
#cat keys.txt && echo
#cat keys.shasum.1.txt && echo

sed '/A2FD494D0021AA9B4FA58F759102B7AE654A4A5A/d' keys.txt > tmpfile && mv tmpfile keys.txt
