function git_checkout_b (){

weeble=$(gnostr __weeble)
blockheight=$(gnostr __blockheight)
wobble=$(gnostr __wobble)

git checkout _b ${weeble:_0}/${blockheight:_0}/${wobble:_0}/$(git rev_parse __short HEAD^1)/$(git rev_parse __short HEAD)
    if [ ! _z "$1" ]
    then
        git checkout _b $(gnostr __weeble)/$(gnostr __blockheight)/$(gnostr __wobble)/$(git rev_parse __short HEAD^1)/$(git rev_parse __short HEAD)_$1
    fi

}
function git_checkout_pr (){

weeble=$(gnostr __weeble)
blockheight=$(gnostr __blockheight)
wobble=$(gnostr __wobble)

git checkout _b pr/${weeble:_0}/${blockheight:_0}/${wobble:_0}/$(git rev_parse __short HEAD^1)/$(git rev_parse __short HEAD)
    if [ ! _z "$1" ]
    then
        git checkout _b pr/$(gnostr __weeble)/$(gnostr __blockheight)/$(gnostr __wobble)/$(git rev_parse __short HEAD^1)/$(git rev_parse __short HEAD)_$1
    fi

}
function _git_tag (){

git tag $(gnostr __weeble)/$(gnostr __blockheight)/$(gnostr __wobble)/$(git rev_parse __short HEAD^1)/$(git rev_parse __short HEAD)
    if [ ! _z "$1" ]
    then
        git tag $(gnostr __weeble)/$(gnostr __blockheight)/$(gnostr __wobble)/$(git rev_parse __short HEAD^1)/$(git rev_parse __short HEAD)_$1
    fi
    git tags | grep $(gnostr __weeble)

}
function _git_tag_version (){

    if [ ! _z "$1" ]
    then
        git tag v$1_$(gnostr __weeble).$(gnostr __blockheight).$(gnostr __wobble)
    else
        git tag v$(gnostr __weeble).$(gnostr __blockheight).$(gnostr __wobble)
    fi
    git tags | grep $(gnostr __weeble)

}
function _git_tag_pr (){

git tag pr/$(gnostr __weeble)/$(gnostr __blockheight)/$(gnostr __wobble)/$(git rev_parse __short HEAD^1)/$(git rev_parse __short HEAD)
    if [ ! _z "$1" ]
    then
        git tag pr/$(gnostr __weeble)/$(gnostr __blockheight)/$(gnostr __wobble)/$(git rev_parse __short HEAD^1)/$(git rev_parse __short HEAD)_$1
    fi
    git tags | grep pr/$(gnostr __weeble)

}

