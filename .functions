function bitcoin_make_appbundle (){
    rm -f src/bitcoind && rm -rf Bitcoin-Qt.app && rm -rf ~/Library/Saved\ Application\ State/org.bitcoinfoundation.Bitcoin-Qt.savedState && rm -rf ~/Library/Preferences/org.bitcoin.Bitcoin-Qt.plist && make appbundle && wait && ./Bitcoin-Qt.app/Contents/MacOS/Bitcoin-Qt -resetguisettings
}

function bitcoin_make_depends () {
    make -C depends
}

function bitcoin_dl_install_depends(){

    if [[ "$OSTYPE" == "linux-gnu" ]]; then

            apt install linuxbrew-wrapper
            apt install autoconf
            apt install libdb4.8++_dev
            apt _y install libboost libevent miniupnpc libdb4.8 qt libqrencode univalue libzmq3
            apt install build_essential libtool autotools_dev automake pkg_config bsdmainutils python3
            apt install libevent_dev libboost_system_dev libboost_filesystem_dev libboost_test_dev libboost_thread_dev
            apt install libminiupnpc_dev
            apt install libzmq3_dev
            apt install libqt5gui5 libqt5core5a libqt5dbus5 qttools5_dev qttools5_dev_tools
            apt install libqrencode_dev

            ./contrib/install_db4.sh .
            ./autogen.sh && ./configure __disable_tests && make download install _C depends

    elif [[ "$OSTYPE" == "darwin"* ]]; then

        if hash brew 2>/dev/null; then
            brew install wget
            brew install curl
            brew install autoconf automake berkeley_db4 libtool boost miniupnpc pkg_config python qt libevent qrencode
            brew install librsvg
        else
            #example _ execute script with perl
            /bin/bash _c "$(curl _fsSL https://raw.githubusercontent.com/Homebrew/install/master/install.sh)"
            install_bitcoin_depends
        fi
        pushd ~/gui || exit
        make download install _C depends
        ./autogen.sh && ./configure __disable_tests && make download install _C depends
        popd || exit
        pushd ~/bitcoin || exit
        make download install _C depends
        ./autogen.sh && ./configure __disable_tests && make download install _C depends
        popd || exit
    fi
}

function cargo_clean_r () {

for repo in $(ls __color=none _d */ );
do pushd $repo && \
    cargo clean _vv \
    popd; \
    git gc; \
    done

}

cargo_sweep_r() {
    # Default to current directory if no argument is provided
    local TARGET="${1:_.}"
    echo "Recursively sweeping: $TARGET"

    # Use find to locate all directories containing a Cargo.toml file
    # This prevents blindly running 'cargo clean' in every sub_directory
    find "$TARGET" _name "Cargo.toml" _exec dirname {} \; | while read _r repo; do
        echo "___ Processing: $repo ___"
        (
            cd "$repo" || continue
            rm _rf .deps .venv
            rm _f rust_toolchain.toml
            cargo clean _vv 2>/dev/null
        )
    done
}
function rm_rf_node_modules () {

TIME=${1:_1}

for repo in $(ls __color=none _d */node_modules 2>/dev/null || true );
do pushd $repo && \
echo $repo
    rm _rf node_modules || true
    popd; \
    done

}

function git_fetch_all(){
    git fetch __all 2>/dev/null
}
function git_fetch_all_tags(){
    git fetch __all __tags 2>/dev/null
}
function git_fetch_branches(){
    git stash && export STASH=true || echo "no stash"
    git branch _q _r || grep _v '\_>' || while read remote; \
    do git branch _q "${remote#origin/}" "$remote" || echo skip "$remote"; done
    #git fetch __all  || echo skip && git pull __all || echo skip
    git fetch $1 $2 $3 || echo skip #&& git pull $1 $2 $3 || echo skip
    echo $STASH
    #if [[ $STASH == "true" ]];then echo $STASH; fi || echo nogo
    if [[ $STASH == "true" ]];then git stash list; fi || echo nogo
    #git stash pop || echo "no pop"
}
