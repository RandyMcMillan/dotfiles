[safe]
	directory = *

[alias]
    lint-config = "!f() { \
        echo 'Checking Git configuration syntax...'; \
        if git config --list --file ${1:-.gitconfig} > /dev/null; then \
            echo '✅ Syntax: OK'; \
        else \
            echo '❌ Syntax: FAILED'; \
            git config --list --file ${1:-.gitconfig}; \
        fi; \
        echo 'Checking for broken paths...'; \
        grep 'path =' ${1:-.gitconfig} | awk '{print $3}' | while read -r path; do \
            real_path=$(eval echo $path); \
            if [ ! -e \"$real_path\" ]; then \
                echo \"⚠️  Broken path found: $path\"; \
            fi; \
        done; \
    }; f"
    # Compare the current notes state with the previous state in the reflog
    notes-diff = "!f() { \
        git diff ${1:-notes/commits@{1}} ${2:-notes/commits@{0}}; \
    }; f"


# Remove all notes pointing to non-existent commits
    notes-prune-orphans = "!f() { \
        for target in $(git find-note-targets); do \
            if ! git cat-file -e \"$target\" 2>/dev/null; then \
                echo \"Pruning orphaned note for $target\"; \
                git notes remove \"$target\"; \
            fi; \
        done; \
    }; f"


    notes-summary = "!f() { \
        RED=$(tput setaf 1); \
        CLR=$(tput sgr0); \
        for target in $(git find-note-targets); do \
            if git cat-file -e \"$target\" 2>/dev/null; then \
                printf \"Target: %s | \" \"$target\"; \
                git log -1 --format=\"%C(auto)%h %s\" \"$target\"; \
            else \
                printf \"Target: %s | ${RED}ORPHANED (Commit Missing)${CLR}\\n\" \"$target\"; \
            fi; \
            git notes show \"$target\" 2>/dev/null | sed 's/^/  [Note]: /'; \
            echo \"-------------------------------------------------------\"; \
        done; \
    }; f"

    # Use this when you have the text-blob hash (from a diff)
    find-note-owner = "!f() { \
        NOTE_BLOB=$1; \
        if [ -z \"$NOTE_BLOB\" ]; then echo \"Usage: git find-note-owner <blob-hash>\"; return 1; fi; \
        TARGET_LINE=$(git ls-tree -r refs/notes/commits | grep \"$NOTE_BLOB\"); \
        if [ -z \"$TARGET_LINE\" ]; then echo \"No note found with blob hash $NOTE_BLOB\"; return 1; fi; \
        TARGET_COMMIT=$(echo \"$TARGET_LINE\" | awk '{print $4}'); \
        git log -1 \"$TARGET_COMMIT\"; \
    }; f"

    # Use this when you have the lognotes hash (the commit on the notes branch)
    find-note-targets = "!f() { \
        NOTES_REV=${1:-refs/notes/commits}; \
        git ls-tree -r $NOTES_REV | awk '{print $4}'; \
    }; f"

	# Switch to a branch, creating it if necessary
	# View abbreviated SHA, description, and history graph of the latest 20 commits.
	l = log --pretty=oneline -n 10 --graph --abbrev-commit
	ll = log --pretty=oneline -n 20 --graph --abbrev-commit
	lll = log --pretty=oneline -n 30 --graph --abbrev-commit

	# View the current working tree status using the short format.
	s = status -s

	# Show the diff between the latest commit and the current state.
	d = !"git diff-index --quiet HEAD -- || clear; git --no-pager diff --patch-with-stat"

	# `git di $number` shows the diff between the state `$number` revisions ago and the current state.
	di = !"d() { git diff --patch-with-stat HEAD~$1; }; git diff-index --quiet HEAD -- || clear; d"

	# Pull in remote changes for the current repository and all its submodules.
	p = pull --recurse-submodules

	# Clone a repository including all submodules.
	c = clone --recursive

	# Commit all changes.
	ca = !git add -A && git commit -av

	# Switch to a branch, creating it if necessary.
	go = "!f() { git checkout -b \"$1\" || git checkout \"$1\"; }; f"

	# Show verbose output about tags, branches or remotes
	tags = tag -l
	branches = branch --all
	remotes = remote --verbose

	# List aliases.
	aliases = config --get-regexp alias

	# Amend the currently staged files to the latest commit.
	amend = commit --amend --reuse-message=HEAD

	# Credit an author on the latest commit.
	credit = "!f() { git commit --amend --author \"$1 <$2>\" -C HEAD; }; f"

	# Interactive rebase with the given number of latest commits.
	reb = "!r() { git rebase -i HEAD~$1; }; r"

	# Remove the old tag with this name and tag the latest commit with it.
	retag = "!r() { git tag -d $1 && git push origin :refs/tags/$1 && git tag $1; }; r"

	# Find branches containing commit
	fb = "!f() { git branch -a --contains $1; }; f"

	# Find tags containing commit
	ft = "!f() { git describe --always --contains $1; }; f"

	# Find commits by source code
	fc = "!f() { git log --pretty=format:'%C(yellow)%h  %Cblue%ad  %Creset%s%Cgreen  [%cn] %Cred%d' --decorate --date=short -S$1; }; f"

	# Find commits by commit message
	fm = "!f() { git log --pretty=format:'%C(yellow)%h  %Cblue%ad  %Creset%s%Cgreen  [%cn] %Cred%d' --decorate --date=short --grep=$1; }; f"



	# Merge GitHub pull request on top of the current branch or,
	# if a branch name is specified, on top of the specified branch
	mpr = "!f() { \
		declare currentBranch=\"$(git symbolic-ref --short HEAD)\"; \
		declare branch=\"${2:-$currentBranch}\"; \
		if [ $(printf \"%s\" \"$1\" | grep '^[0-9]\\+$' > /dev/null; printf $?) -eq 0 ]; then \
			git fetch origin refs/pull/$1/head:pr/$1 && \
			git checkout -B $branch && \
			git rebase $branch pr/$1 && \
			git checkout -B $branch && \
			git merge pr/$1 && \
			git branch -D pr/$1 && \
			git commit --amend -m \"$(git log -1 --pretty=%B)\n\nCloses #$1.\"; \
		fi \
	}; f"

	# Remove branches that have already been merged with main.
	# a.k.a. ‘delete merged’
	dm = "!git branch --merged | grep -v '\\*' | xargs -n 1 git branch -d"

	# List contributors with number of commits.
	contributors = shortlog --summary --numbered

	# Show the user email for the current repository.
	whoami = config user.email
	gc = gc

[apply]

	# Detect whitespace errors when applying a patch
	whitespace = fix

[branch]

	# Show most recently changed branches first.
	sort = -committerdate

[core]

	# Use custom `.gitignore` and `.gitattributes`.
	excludesfile = ~/.gitignore
	attributesfile = ~/.gitattributes

	# Treat spaces before tabs and all kinds of trailing whitespace as an error.
	# [default] trailing-space: looks for spaces at the end of a line
	# [default] space-before-tab: looks for spaces before tabs at the beginning of a line
	whitespace = space-before-tab,-indent-with-non-tab,trailing-space,fix

	# Make `git rebase` safer on macOS.
	# More info: <http://www.git-tower.com/blog/make-git-rebase-safe-on-osx/>
	trustctime = false

	# Prevent showing files whose names contain non-ASCII symbols as unversioned.
	# http://michael-kuehnel.de/git/2014/11/21/git-mac-osx-and-german-umlaute.html
	precomposeunicode = false

	# Speed up commands involving untracked files such as `git status`.
	# https://git-scm.com/docs/git-update-index#_untracked_cache
	untrackedCache = true

[color]

	# Use colors in Git commands that are capable of colored output when
	# outputting to the terminal. (This is the default setting in Git ≥ 1.8.4.)
	ui = auto

[color "branch"]

	current = yellow reverse
	local = yellow
	remote = green

[color "diff"]

	meta = yellow bold
	frag = magenta bold # line info
	old = red # deletions
	new = green # additions

[color "status"]

	added = yellow
	changed = green
	untracked = cyan

[commit]

	# https://help.github.com/articles/signing-commits-using-gpg/
	gpgsign = true

[diff]

	# Detect copies as well as renames.
	renames = copies

[diff "bin"]

	# Use `hexdump` to diff binary files.
	textconv = hexdump -v -C

[help]

	# Automatically correct and execute mistyped commands.
	autocorrect = 1

[merge]

	# Include summaries of merged commits in newly created merge commit messages
	log = true

[push]

	# https://git-scm.com/docs/git-config#git-config-pushdefault
	default = simple
	# Make `git push` push relevant annotated tags when pushing branches out.
	followTags = true

# URL shorthands

[url "git@github.com:"]

	insteadOf = "gh:"
	pushInsteadOf = "github:"
	pushInsteadOf = "git://github.com/"

[url "git://github.com/"]

	insteadOf = "github:"

[url "git@gist.github.com:"]

	insteadOf = "gst:"
	pushInsteadOf = "gist:"
	pushInsteadOf = "git://gist.github.com/"

[url "git://gist.github.com/"]

	insteadOf = "gist:"

[init]

	templateDir = ~/.config/git/template/
	defaultBranch = main

[user]
	signingkey = A80B2B4F04E32821
	name = randymcmillan
	email = randymcmillan@protonmail.com




[alias]
    ls-subtrees = !"for i in $(git log | grep git-subtree-dir | sed -e 's/^.*: //g' | uniq); do test -d $i && echo $i; done"

[alias]
    DATE = !"date +%Y/%j/"$(git rev-parse --short HEAD)

