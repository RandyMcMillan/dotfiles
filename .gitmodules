[submodule "vimrc"]
	path = .vim_runtime
	url = https://github.com/randymcmillan/vimrc.git
[submodule "scripts/install"]
	path = scripts/install
	url = git@github.com:RandyMcMillan/install.git
[submodule "nodegit"]
	path = nodegit
	url = https://github.com/RandyMcMillan/nodegit.git
[submodule ".vim_runtime"]
	path = .vim_runtime
	url = https://github.com/randymcmillan/vimrc.git
