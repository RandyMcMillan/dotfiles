#!/usr/bin/env bash
set -euo pipefail

INSTALL_DIR="/usr/local/bin"
SCRIPT_NAME="git-clone-gists"
CLONE_DIR="${CLONE_DIR:-gists}"

show_usage() {
  cat <<EOF
Usage: $0 [install|uninstall|--help] [--force] [github-username] [github-token]

Defaults:
  github-username  randymcmillan
  github-token     optional token argument or GH_TOKEN env var
  --force          overwrite existing gist directories instead of fetching

The script clones all gists for the chosen user into ./gists and refreshes
~/gists to point at that directory.
EOF
}

install_script() {
  if [ ! -d "$INSTALL_DIR" ]; then
    echo "Error: installation directory '$INSTALL_DIR' does not exist."
    exit 1
  fi

  cp "$0" "$INSTALL_DIR/$SCRIPT_NAME"
  chmod +x "$INSTALL_DIR/$SCRIPT_NAME"
  echo "Installed '$SCRIPT_NAME' to '$INSTALL_DIR/$SCRIPT_NAME'."
}

uninstall_script() {
  rm -f "$INSTALL_DIR/$SCRIPT_NAME"
  echo "Removed '$INSTALL_DIR/$SCRIPT_NAME'."
}

case "${1:-}" in
  install)
    install_script
    exit 0
    ;;
  uninstall)
    uninstall_script
    exit 0
    ;;
  -h|--help|help)
    show_usage
    exit 0
    ;;
esac

FORCE_OVERWRITE=0
if [ "${1:-}" = "--force" ] || [ "${1:-}" = "-f" ]; then
  FORCE_OVERWRITE=1
  shift
fi

GITHUB_USERNAME="${1:-randymcmillan}"
if [ $# -ge 2 ]; then
  GITHUB_PAT="$2"
else
  GITHUB_PAT=""
fi

command -v gh >/dev/null
command -v git >/dev/null

if [ -n "$GITHUB_PAT" ]; then
  export GH_TOKEN="$GITHUB_PAT"
fi

echo "Starting Gist cloning process for user: $GITHUB_USERNAME"

mkdir -p "$CLONE_DIR"
ln -sfn "$PWD/$CLONE_DIR" "$HOME/gists"
cd "$CLONE_DIR"
mkdir -p "$GITHUB_USERNAME"

ALL_GISTS=()
if ! GIST_IDS="$(
  gh api --paginate "users/$GITHUB_USERNAME/gists?per_page=100" --jq '.[].id'
)"; then
  echo "Error: unable to list gists for $GITHUB_USERNAME. Authenticate with gh or pass a valid token." >&2
  exit 1
fi

while IFS= read -r gist_id; do
  gist_id="${gist_id//$'\r'/}"
  if [[ "$gist_id" =~ ^[0-9a-f]{32}$ ]]; then
    ALL_GISTS+=("$gist_id")
  fi
done <<<"$GIST_IDS"

if [ "${#ALL_GISTS[@]}" -eq 0 ]; then
  echo "No gists found for user $GITHUB_USERNAME."
  exit 0
fi

echo "Found ${#ALL_GISTS[@]} gists to clone."

for GIST_ID in "${ALL_GISTS[@]}"; do
  GIST_URL="https://gist.github.com/$GITHUB_USERNAME/$GIST_ID"
  GIST_DIR_NAME="$GITHUB_USERNAME/${GIST_ID:0:7}"

  if [ -e "$GIST_DIR_NAME" ] && [ "$FORCE_OVERWRITE" -eq 1 ]; then
    echo "Refreshing existing directory $GIST_URL"
    rm -rf "$GIST_DIR_NAME"
  elif [ -d "$GIST_DIR_NAME/.git" ]; then
    echo "Fetching updates for $GIST_URL"
    git -C "$GIST_DIR_NAME" fetch --all --prune >/dev/null
    continue
  elif [ -e "$GIST_DIR_NAME" ]; then
    echo "Error: '$GIST_DIR_NAME' exists but is not a git repository. Re-run with --force." >&2
    exit 1
  fi

  echo "Cloning $GIST_URL into gist/$GIST_DIR_NAME"
  gh gist clone "$GIST_ID" "$GIST_DIR_NAME" >/dev/null
done

echo "Gist cloning process completed."
